@page
@model TeacherProfileForm.Pages.IndexModel
@{
    ViewData["Title"] = "Teacher Profile Form";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <style>
        body {
            font-family: Arial, sans-serif;
        }
        fieldset {
            margin: 20px auto;
            padding: 20px;
            max-width: 600px;
        }
        table {
            width: 100%;
        }
        td {
            padding: 8px;
        }
        .error-message {
            color: red;
            font-size: 0.9em;
        }
        .success-message {
            color: green;
            text-align: center;
            margin: 20px;
            font-weight: bold;
        }
    </style>
</head>
<body>
    <h1 align="center"><u>Teacher Profile Form</u></h1>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="success-message">
            @Model.SuccessMessage<br />
            <a href="/Teachers/ShowData">See the Teacher's Data</a>
        </div>
    }

    <form method="post" enctype="multipart/form-data">
        <!-- Personal Information -->
        <fieldset style="background-color: rgb(194, 223, 235)">
            <legend style="font-size: larger; text-align: center">
                <b><i>Personal Information:</i></b>
            </legend>
            <table align="center" cellpadding="8">
                <tr>
                    <td><label asp-for="Teacher.FullName">Full Name:</label></td>
                    <td>
                        <input asp-for="Teacher.FullName" type="text" required />
                        <span asp-validation-for="Teacher.FullName" class="error-message"></span>
                    </td>
                </tr>
                <tr>
                    <td><label asp-for="Teacher.NID">NID:</label></td>
                    <td>
                        <input asp-for="Teacher.NID" type="text" required />
                        <span asp-validation-for="Teacher.NID" class="error-message"></span>
                    </td>
                </tr>
                <tr>
                    <td><p>Select Gender:</p></td>
                    <td>
                        <input asp-for="Teacher.Gender" type="radio" value="Male" id="male" required />
                        <label for="male">Male</label>
                        <input asp-for="Teacher.Gender" type="radio" value="Female" id="female" />
                        <label for="female">Female</label>
                        <span asp-validation-for="Teacher.Gender" class="error-message"></span>
                    </td>
                </tr>
                <tr>
                    <td><label asp-for="Teacher.PresentAddress">Present Address:</label></td>
                    <td>
                        <textarea asp-for="Teacher.PresentAddress" rows="3" cols="20" required></textarea>
                        <span asp-validation-for="Teacher.PresentAddress" class="error-message"></span>
                    </td>
                </tr>
                <tr>
                    <td><label asp-for="Teacher.Mobile">Mobile:</label></td>
                    <td>
                        <input asp-for="Teacher.Mobile" type="text" required />
                        <span asp-validation-for="Teacher.Mobile" class="error-message"></span>
                    </td>
                </tr>
                <tr>
                    <td><label asp-for="Teacher.Email">Email:</label></td>
                    <td>
                        <input asp-for="Teacher.Email" type="email" required />
                        <span asp-validation-for="Teacher.Email" class="error-message"></span>
                    </td>
                </tr>
                <tr>
                    <td><label for="imageFile">Attach Image:</label></td>
                    <td>
                        <input type="file" id="imageFile" name="ImageFile" accept="image/*" />
                    </td>
                </tr>
            </table>
        </fieldset>

        <!-- Professional Information -->
        <fieldset style="background-color: rgb(249, 235, 222)">
            <legend style="font-size: larger; text-align: center">
                <b><i>Professional Information:</i></b>
            </legend>
            <table align="center" cellpadding="8">
                <tr>
                    <td><label asp-for="Teacher.Faculty">Faculty:</label></td>
                    <td>
                        <select asp-for="Teacher.Faculty">
                            <option value="Science&Engg.">Faculty Of Science and Engineering</option>
                            <option value="Arts">Faculty Of Arts</option>
                            <option value="BBA">Faculty Of BBA</option>
                            <option value="SocialScience">Faculty Of Social Science</option>
                        </select>
                        <span asp-validation-for="Teacher.Faculty" class="error-message"></span>
                    </td>
                </tr>
                <tr>
                    <td><label asp-for="Teacher.Department">Department:</label></td>
                    <td>
                        <select asp-for="Teacher.Department">
                            <option value="CSE">Department Of CSE</option>
                            <option value="EEE">Department Of EEE</option>
                            <option value="ESE">Department of ESE</option>
                        </select>
                        <span asp-validation-for="Teacher.Department" class="error-message"></span>
                    </td>
                </tr>
                <tr>
                    <td><label asp-for="Teacher.Designation">Designation:</label></td>
                    <td>
                        <select asp-for="Teacher.Designation">
                            <option value="Professor">Professor</option>
                            <option value="Associate Professor">Associate Professor</option>
                            <option value="Assistant Professor">Assistant Professor</option>
                            <option value="Lecturer">Lecturer</option>
                        </select>
                        <span asp-validation-for="Teacher.Designation" class="error-message"></span>
                    </td>
                </tr>
                <tr>
                    <td><label asp-for="Teacher.JoiningDate">Joining Date:</label></td>
                    <td>
                        <input asp-for="Teacher.JoiningDate" type="date" required />
                        <span asp-validation-for="Teacher.JoiningDate" class="error-message"></span>
                    </td>
                </tr>
                <tr>
                    <td><label asp-for="Teacher.Qualification">Qualification:</label></td>
                    <td>
                        <input asp-for="Teacher.Qualification" type="text" required />
                        <span asp-validation-for="Teacher.Qualification" class="error-message"></span>
                    </td>
                </tr>
                <tr>
                    <td><label asp-for="Teacher.Experience">Experience:</label></td>
                    <td>
                        <input asp-for="Teacher.Experience" type="number" min="0" required />
                        <span asp-validation-for="Teacher.Experience" class="error-message"></span>
                    </td>
                </tr>
            </table>
        </fieldset>

        <div style="text-align: center; margin: 20px;">
            <button type="submit"><b>Submit</b></button>
        </div>
    </form>

    @section Scripts {
        @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    }
</body>
</html>