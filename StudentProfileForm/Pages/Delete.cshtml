@page "{id:int}"
@model StudentProfileForm.Pages.DeleteModel
@{
    ViewData["Title"] = "Delete Student";
}

<h2 style="text-align: center;"><u>Delete Student</u></h2>

<div style="text-align: center; margin: 20px;">
    <h3>Are you sure you want to delete this student?</h3>
    
    <div style="background-color: #f8f9fa; padding: 20px; display: inline-block; text-align: left; border: 1px solid #dee2e6; border-radius: 4px;">
        <p><strong>Name:</strong> @Model.Student.Name</p>
        <p><strong>Father's Name:</strong> @Model.Student.FatherName</p>
        <p><strong>Mother's Name:</strong> @Model.Student.MotherName</p>
        <p><strong>Roll:</strong> @Model.Student.Roll</p>
        <p><strong>Department:</strong> @Model.Student.Department</p>
        <p><strong>Email:</strong> @Model.Student.Email</p>
        <p><strong>Mobile:</strong> @Model.Student.Mobile</p>
    </div>
    
    <br /><br />
    
    <form method="post" style="display: inline;">
        <button type="submit" style="background-color: #dc3545; color: white; padding: 10px 20px; border: none; cursor: pointer;">Delete</button>
    </form>
    <a href="/Students" style="margin-left: 10px; padding: 10px 20px; background-color: #6c757d; color: white; text-decoration: none; display: inline-block;">Cancel</a>
</div>