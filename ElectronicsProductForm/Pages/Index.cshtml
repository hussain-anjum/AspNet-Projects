@page
@model ElectronicsProductForm.Pages.IndexModel
@{
    ViewData["Title"] = "Electronics Product Entry Form";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 20px;
        }
        table {
            margin: 0 auto;
        }
        td {
            padding: 8px;
        }
        input[type="text"],
        input[type="number"],
        select,
        textarea {
            width: 250px;
            padding: 5px;
        }
        .success-message {
            color: green;
            text-align: center;
            margin: 20px;
            font-weight: bold;
        }
        .error-message {
            color: red;
            font-size: 0.9em;
        }
    </style>
</head>
<body>
    <h1 align="center"><u>Electronics Product Entry Form</u></h1>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="success-message">
            @Model.SuccessMessage<br />
            <a href="/Products/ViewAll">View All Products</a>
        </div>
    }

    <form method="post">
        <table align="center" cellpadding="8">
            <tr>
                <td><label asp-for="Product.ProductName">Product Name:</label></td>
                <td>
                    <input asp-for="Product.ProductName" type="text" required />
                    <span asp-validation-for="Product.ProductName" class="error-message"></span>
                </td>
            </tr>
            <tr>
                <td><label asp-for="Product.Brand">Brand:</label></td>
                <td>
                    <input asp-for="Product.Brand" type="text" required />
                    <span asp-validation-for="Product.Brand" class="error-message"></span>
                </td>
            </tr>
            <tr>
                <td><label asp-for="Product.ModelNumber">Model Number:</label></td>
                <td>
                    <input asp-for="Product.ModelNumber" type="text" required />
                    <span asp-validation-for="Product.ModelNumber" class="error-message"></span>
                </td>
            </tr>
            <tr>
                <td><label asp-for="Product.Category">Category:</label></td>
                <td>
                    <select asp-for="Product.Category" required>
                        <option value="">--Select Category--</option>
                        <option value="Mobile">Mobile</option>
                        <option value="Laptop">Laptop</option>
                        <option value="Tablet">Tablet</option>
                        <option value="TV">TV</option>
                        <option value="Accessory">Accessory</option>
                    </select>
                    <span asp-validation-for="Product.Category" class="error-message"></span>
                </td>
            </tr>
            <tr>
                <td><label asp-for="Product.Price">Price (USD):</label></td>
                <td>
                    <input asp-for="Product.Price" type="number" step="0.01" required />
                    <span asp-validation-for="Product.Price" class="error-message"></span>
                </td>
            </tr>
            <tr>
                <td><label asp-for="Product.Quantity">Quantity:</label></td>
                <td>
                    <input asp-for="Product.Quantity" type="number" required />
                    <span asp-validation-for="Product.Quantity" class="error-message"></span>
                </td>
            </tr>
            <tr>
                <td><label asp-for="Product.WarrantyMonths">Warranty Period (months):</label></td>
                <td>
                    <input asp-for="Product.WarrantyMonths" type="number" required />
                    <span asp-validation-for="Product.WarrantyMonths" class="error-message"></span>
                </td>
            </tr>
            <tr>
                <td><label asp-for="Product.Description">Description:</label></td>
                <td>
                    <textarea asp-for="Product.Description" rows="4" cols="30" required></textarea>
                    <span asp-validation-for="Product.Description" class="error-message"></span>
                </td>
            </tr>
            <tr>
                <td colspan="2" align="center">
                    <input type="submit" value="Save Product" />
                    <input type="reset" value="Reset" />
                </td>
            </tr>
        </table>
    </form>

    @if (Model.ShowProductInfo && Model.Product != null)
    {
        <div style="margin: 30px auto; width: 600px; border: 1px solid #ccc; padding: 20px; background-color: #f9f9f9;">
            <h3>Product Info:</h3>
            <pre>
Product Name: @Model.Product.ProductName
Brand: @Model.Product.Brand
Model Number: @Model.Product.ModelNumber
Category: @Model.Product.Category
Price: $@Model.Product.Price
Quantity: @Model.Product.Quantity
Warranty: @Model.Product.WarrantyMonths months
Description: @Model.Product.Description
            </pre>
        </div>
    }

    @section Scripts {
        @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
        <script>
            // Prevent double form submission
            document.querySelector('form').addEventListener('submit', function(e) {
                var submitButton = document.querySelector('input[type="submit"]');
                submitButton.disabled = true;
                submitButton.value = "Saving...";
            });
        </script>
    }
</body>
</html>