@page
@model StudentProfileValidation.Pages.ResultModel
@{
    ViewData["Title"] = "Student Details";
}

<h2><u>Student Details</u></h2>

<div style="margin: 20px;">
    <p><strong>Student's Name:</strong> @Model.Name</p>
    <p><strong>Father's Name:</strong> @Model.FatherName</p>
    <p><strong>Mother's Name:</strong> @Model.MotherName</p>
    <p><strong>Date of Birth:</strong> @Model.DateOfBirth?.ToString("yyyy-MM-dd")</p>
    <p><strong>Sex:</strong> @Model.Sex</p>
    <p><strong>Phone Number:</strong> @Model.Phone</p>
    <p><strong>Email:</strong> @Model.Email</p>
    <p><strong>Present Address:</strong> @Model.PresentAddress</p>
    <p><strong>Permanent Address:</strong> @Model.PermanentAddress</p>
</div>

<div style="margin: 20px;">
    <a asp-page="/Index" class="btn btn-primary">Back to Form</a>
</div>